   ],
   "source": [
    "#regarder les courbes avec cumul de la conso par année\n",
    "# fonction cumsum + groupby\n",
    "consoCumul = conso.groupby(conso.index.year)['conso'].cumsum()\n",
    "consoCumul = pd.DataFrame({'Date': consoCumul.index, 'conso': consoCumul.values})\n",
    "consoCumul['Date'] = pd.to_datetime(consoCumul['Date'])\n",
    "consoCumul.set_index('Date', inplace=True)\n",
    "print(consoCumul.head(1))\n",
    "\n",
    "plt.figure(figsize=(8, 8))\n",
    "for annee in range(conso.index.min().year, conso.index.max().year + 1):\n",
    "    consoC_annee = consoCumul[consoCumul.index.year == annee]\n",
    "    plt.plot(range(len(consoC_annee)), consoC_annee.values, label=f'Conso {annee}')\n",
    "plt.legend(loc='best')\n",
    "plt.title('Courbes cumulées des Consommation par Année')\n",
    "plt.show()\n"
   ]
  },
