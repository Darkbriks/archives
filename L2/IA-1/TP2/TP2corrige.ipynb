    "# visualisation de chaque armoire sur le même graphe Puis en somme cumulée\n",
    "plt.figure(figsize=(12, 6))\n",
    "for armoire in df['Bâtiment ou Rue'].unique():\n",
    "    conso_lieu = df[df['Bâtiment ou Rue'] == armoire]\n",
    "    plt.plot(conso_lieu['Consommation (kWhEN)'], label=f'Conso {armoire}')\n",
    "# Ajoutez une légende pour chaque lieu\n",
