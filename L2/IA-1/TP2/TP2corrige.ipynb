   "source": [
    "# tracer un graphe avec pour abscisses les mois, et en ordonnée la conso. \n",
    "# superposer chaque année avec une legende\n",
    "plt.figure(figsize=(15, 10))\n",
    "for annee in range(conso.index.min().year, conso.index.max().year + 1):\n",
