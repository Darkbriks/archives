.policyLinks.4":{"title":"Conditions d'utilisation","url":"https://www.lego.com/fr-fr/legal/legal-notice","imageUrl":null,"__typename":"FooterLink"},"$ROOT_QUERY.globalBanner":{"title":"Global Banner","banners":[{"type":"id","generated":false,"id":"GlobalBannerSection:bltc05e649ef825d9e4","typename":"GlobalBannerSection"},{"type":"id","generated":false,"id":"DummySection:empty_section","typename":"DummySection"},{"type":"id","generated":false,"id":"DummySection:empty_section","typename":"DummySection"},{"type":"id","generated":false,"id":"DummySection:empty_section","typename":"DummySection"},{"type":"id","generated":false,"id":"GlobalBannerSection:blt303bcd56da94b278","typename":"GlobalBannerSection"}],"__typename":"GlobalBanner"},"GlobalBannerSection:bltc05e649ef825d9e4":{"id":"bltc05e649ef825d9e4","__typename":"GlobalBannerSection","title":"2020-01 HP SWB Novelties","section":[{"type":"id","generated":true,"id":"GlobalBannerSection:bltc05e649ef825d9e4.section.0","typename":"GlobalBannerChild"}]},"GlobalBannerSection:bltc05e649ef825d9e4.section.0":{"title":"Découvre les nouveautés de 2020","image":"https://sh-s7-live-s.legocdn.com/is/image/LEGOMKTG/2020-Novelty-201912-Sitewide-Banner?$sitewide$","callToActionLink":"/categories/new-sets-and-products?icmp=SW-SHB-EG-MT-novelt-1474","callToActionText":"Visiter la boutique","__typename":"GlobalBannerChild"},"DummySection:empty_section":{"id":"empty_section","__typename":"DummySection"},"GlobalBannerSection:blt303bcd56da94b278":{"id":"blt303bcd56da94b278","__typename":"GlobalBannerSection","title":"Global Banner - Free Shipping","section":[{"type":"id","generated":true,"id":"GlobalBannerSection:blt303bcd56da94b278.section.0","typename":"GlobalBannerChild"}]},"GlobalBannerSection:blt303bcd56da94b278.section.0":{"title":"Livraison gratuite pour toute commande de plus de 55 € !","image":"https://sh-s7-live-s.legocdn.com/is/image/LEGOMKTG/free-shipping--201606--gl--sitewide-banner?$sitewide$","callToActionLink":"/page/free-delivery?icmp=SW-SHB-EG-NO-freesh-204","callToActionText":"En savoir plus","__typename":"GlobalBannerChild"},"SingleVariantProduct:b4390adc-2330-408f-88f8-79bcb6f41a41":{"id":"b4390adc-2330-408f-88f8-79bcb6f41a41","productCode":"60253","name":"Le camion de la marchande de glaces","slug":"ice-cream-truck-60253","metaTitle":"Le camion de la marchande de glaces 60253 | City | Boutique LEGO® officielle FR","metaDescription":"Un camion de glaces multicolore et magique !","variant":{"type":"id","generated":false,"id":"ProductVariant:6288838","typename":"ProductVariant"},"__typename":"SingleVariantProduct","primaryImageUrl({\"size\":\"HIRES\"})":"https://sh-s7-live-s.legocdn.com/is/image/LEGO/60253?scl=1.7&op_sharpen=1","primaryImage({\"size\":\"HIRES\"})":null,"productImages":{"type":"id","generated":true,"id":"$SingleVariantProduct:b4390adc-2330-408f-88f8-79bcb6f41a41.productImages","typename":"Scene7MediaSet"},"productMedia":null,"description":"Les enfants deviennent des héros du quotidien avec ce set de jeu amusant LEGO® City Le camion de la marchande de glaces (60253). Les enfants peuvent servir de délicieux cornets de crème glacée et des glaces à l’eau aux citoyens de LEGO City qui étouffent de chaleur ! Le set inclut un camion avec suffisamment de place à l'intérieur pour que la marchande de glaces puisse travailler et conduire, ainsi qu'un client en skateboard avec un adorable chien, pour des possibilités infinies de jeu de rôle autonome et amusant.\n\nUn set de construction fantastique pour les enfants\nLes instructions de montage du camion de la marchande de glaces LEGO City sont incluses dans la boîte. Il est également possible de télécharger en ligne le guide Instructions PLUS, dans l'appli LEGO Life pour smartphones et tablettes. Ce guide de construction interactif, qui inclut de formidables outils de zoom, de rotation et de visualisation, transforme les constructeurs LEGO en herbe en véritables maîtres constructeurs.\n\nJouets LEGO City sur le thème des super véhicules\nAvec les sets de jeu LEGO City sur le thème des super véhicules, les enfants peuvent explorer de près leurs véhicules et engins terrestres, aériens et aquatiques préférés. Ces jouets de construction réalistes inspirent le jeu d'imagination qui reflète la vie réelle de manière amusante et passionnante.","secondaryImageUrl({\"size\":\"THUMBNAIL\"})":"https://sh-s7-live-s.legocdn.com/is/image/LEGO/60253_alt1?wid=320&hei=320","secondaryImage({\"size\":\"THUMBNAIL\"})":null,"productCategories":[{"type":"id","generated":true,"id":"SingleVariantProduct:b4390adc-2330-408f-88f8-79bcb6f41a41.productCategories.0","typename":"Category"},{"type":"id","generated":true,"id":"SingleVariantProduct:b4390adc-2330-408f-88f8-79bcb6f41a41.productCategories.1","typename":"Category"},{"type":"id","generated":true,"id":"SingleVariantProduct:b4390adc-2330-408f-88f8-79bcb6f41a41.productCategories.2","typename":"Category"},{"type":"id","generated":true,"id":"SingleVariantProduct:b4390adc-2330-408f-88f8-79bcb6f41a41.productCategories.3","typename":"Category"}],"brandCategory":{"type":"id","generated":true,"id":"$SingleVariantProduct:b4390adc-2330-408f-88f8-79bcb6f41a41.brandCategory","typename":"Category"},"primaryImageUrl({\"size\":\"THUMBNAIL\"})":"https://sh-s7-live-s.legocdn.com/is/image/LEGO/60253?wid=320&hei=320","primaryImage({\"size\":\"THUMBNAIL\"})":null,"primaryImageUrl":"https://sh-s7-live-s.legocdn.com/is/image/LEGO/60253","overrideUrl":null,"contentSections":[]},"ProductVariant:6288838":{"vipPoints":150,"attributes":{"type":"id","generated":true,"id":"$ProductVariant:6288838.attributes","typename":"ProductAttributes"},"__typename":"ProductVariant","images":[],"id":"6288838","sku":"6288838","price":{"type":"id","generated":true,"id":"$ProductVariant:6288838.price","typename":"Price"},"listPrice":{"type":"id","generated":true,"id":"$ProductVariant:6288838.listPrice","typename":"Price"},"salePercentage":0,"promotion":null},"$ProductVariant:6288838.attributes":{"availabilityStatus":"E_AVAILABLE","availabilityText":"Disponible","vipAvailabilityStatus":null,"vipAvailabilityText":null,"canAddToBag":true,"vipCanAddToBag":null,"ageRange":"5+","pieceCount":200,"has3DModel":true,"headlineText":"Un camion de glaces multicolore et magique !","isNew":true,"onSale":false,"rating":null,"__typename":"ProductAttributes","bulletText":"\u003cul>\u003cli>\u003c/li>\u003cli> Tous les enfants aiment les glaces ! Ils passeront une agréable journée d’été avec le set de construction Le camion de la marchande de glaces LEGO® City, conçu pour inspirer le jeu de rôle créatif et autonome inspiré de la vie quotidienne.\n\u003c/li>\u003cli> Set de construction pour enfants comprenant un camion de glaces aux couleurs vives avec les figurines d'une marchande de glaces et d'un skateur, ainsi qu'un chien. Idéal pour le jeu d'imagination en autonomie.\n\u003c/li>\u003cli> Les enfants peuvent aider la marchande deglaces à conduire le camion, à servir des cornets de crèmes glacées et des glaces à l’eau au comptoir et aider le skateur à réaliser d’incroyables figures. Ce camion de glaces coloré est également un formidable objet à exposer.\n\u003c/li>\u003cli> Le camion de la marchande de glaces LEGO® City (60253) constitue un formidable cadeau de Noël, d'anniversaire ou autre pour les enfants de 5 ans et plus, ainsi que pour les garçons et les filles qui adorent les modèles de véhicules. Nécessite uniquement des compétences élémentaires en construction.\n\u003c/li>\u003cli> Une fois construit, le camion de la marchande de glaces mesure plus de 11 cm de haut, 15 cm de long et 6 cm de large. L’espace à l’intérieur du camion est suffisant pour permettre à la marchande de glaces de conduire et de servir les clients.\n\u003c/li>\u003cli> Pas besoin de piles pour ce formidable set LEGO® City Le camion de la marchande de glaces, il fonctionne grâce à l'imagination débordante des jeunes enfants, le jeu peut donc commencer immédiatement.\n\u003c/li>\u003cli> Avec ce set, la construction est vraiment un jeu d’enfant. Il inclut un guide de construction imprimé et propose également Instructions PLUS, un guide de construction interactif pour les enfants. Disponible dans l'appli gratuite LEGO® Life pour appareils intelligents.\n\u003c/li>\u003cli> Les jouets LEGO® City sur le thème des super véhicules inspirent le jeu créatif, aident les enfants à améliorer leurs aptitudes physiques et développent leur confiance en eux. Les enfants peuvent explorer toutes sortes de véhicules et créer desscénarios de jeu qui reflètent la vie d'une manière amusante et passionnante.\n\u003c/li>\u003cli> Les sets de construction LEGO® sont conformes aux normes industrielles les plus élevées afin de garantir que les sets de jeu LEGO City sont compatibles entre eux et que toutes les pièces LEGO s'assemblent et se séparent toujours facilement.\n\u003c/li>\u003cli> Le groupe LEGO soumet toutes les pièces LEGO® à des tests rigoureux afin de s'assurer que chaque set de jeu est conforme aux normes les plus élevées au monde en matière de sécurité et de qualité.\u003c/li>\u003c/ul>","canAddToWishlist":true,"emergencyText":null,"maxOrderQuantity":5,"skuSelectorValue":null,"showStoreInventory":true,"safetyWarning":{"type":"id","generated":true,"id":"$ProductVariant:6288838.attributes.safetyWarning","typename":"ProductSafetyWarning"},"featuredFlags":[{"type":"id","generated":true,"id":"$ProductVariant:6288838.attributes.featuredFlags.0","typename":"FeaturedFlags"}]},"Scene7Image:myeQp0":{"id":"myeQp0","__typename":"Scene7Image","baseImgUrl":"https://sh-s7-live-s.legocdn.com/is/image/LEGO/60253","intrinsicWidth":2400,"intrinsicHeight":1800,"sizes":{"type":"id","generated":true,"id":"$Scene7Image:myeQp0.sizes","typename":"Scene7ImageSizes"}},"Scene7Image:cRlQN3":{"id":"cRlQN3","__typename":"Scene7Image","baseImgUrl":"https://sh-s7-live-s.legocdn.com/is/image/LEGO/60253_alt1","intrinsicWidth":2400,"intrinsicHeight":1800,"sizes":{"type":"id","generated":true,"id":"$Scene7Image:cRlQN3.sizes","typename":"Scene7ImageSizes"}},"Scene7Image:-JnSJ2":{"id":"-JnSJ2","__typename":"Scene7Image","baseImgUrl":"https://sh-s7-live-s.legocdn.com/is/image/LEGO/60253_alt2","intrinsicWidth":1930,"intrinsicHeight":1448,"sizes":{"type":"id","generated":true,"id":"$Scene7Image:-JnSJ2.sizes","typename":"Scene7ImageSizes"}},"Scene7Image:EtoQD3":{"id":"EtoQD3","__typename":"Scene7Image","baseImgUrl":"https://sh-s7-live-s.legocdn.com/is/image/LEGO/60253_alt3","intrinsicWidth":2400,"intrinsicHeight":1800,"sizes":{"type":"id","generated":true,"id":"$Scene7Image:EtoQD3.sizes","typename":"Scene7ImageSizes"}},"Scene7Image:t2-P93":{"id":"t2-P93","__typename":"Scene7Image","baseImgUrl":"https://sh-s7-live-s.legocdn.com/is/image/LEGO/60253_alt4","intrinsicWidth":2400,"intrinsicHeight":1800,"sizes":{"type":"id","generated":true,"id":"$Scene7Image:t2-P93.sizes","typename":"Scene7ImageSizes"}},"Scene7Image:lDRPB3":{"id":"lDRPB3","__typename":"Scene7Image","baseImgUrl":"https://sh-s7-live-s.legocdn.com/is/image/LEGO/60253_alt6","intrinsicWidth":2400,"intrinsicHeight":1800,"sizes":{"type":"id","generated":true,"id":"$Scene7Image:lDRPB3.sizes","typename":"Scene7ImageSizes"}},"Scene7Image:BYeQn2":{"id":"BYeQn2","__typename":"Scene7Image","baseImgUrl":"https://sh-s7-live-s.legocdn.com/is/image/LEGO/60253_alt7","intrinsicWidth":4878,"intrinsicHeight":3656,"sizes":{"type":"id","generated":true,"id":"$Scene7Image:BYeQn2.sizes","typename":"Scene7ImageSizes"}},"Scene7Image:Hr2Q92":{"id":"Hr2Q92","__typename":"Scene7Image","baseImgUrl":"https://sh-s7-live-s.legocdn.com/is/image/LEGO/60253_alt8","intrinsicWidth":3780,"intrinsicHeight":2833,"sizes":{"type":"id","generated":true,"id":"$Scene7Image:Hr2Q92.sizes","typename":"Scene7ImageSizes"}},"Scene7VideoSet:yjCT80":{"id":"yjCT80","__typename":"Scene7VideoSet","formats":[{"type":"id","generated":true,"id":"Scene7VideoSet:yjCT80.formats.0","typename":"Scene7VideoFormat"},{"type":"id","generated":true,"id":"Scene7VideoSet:yjCT80.formats.1","t